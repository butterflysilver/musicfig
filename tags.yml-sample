# Base path of mp3 folder
mp3_dir: /path/to/base/mp3/folder

# Pad lights: on = green when idle + lightshow while MP3s play;
# off = pads dark, a pad lights only while a figure is on it.
# Read once at startup: restart musicfig after changing it.
lights: on

# Apple TV (optional): pairing from pyatv, plus two knobs for the youtube: action.
# appletv_name: Game Room
# appletv_id: "AA:BB:CC:DD:EE:FF"
# appletv_companion_credentials: "..."
# appletv_cec_wake: true     # sleep/wake the Apple TV so the TV switches to its input (HDMI-CEC)
# youtube_ok_delay: 4        # press Select N s after the launch (YouTube account chooser)
# appletv_ip: 192.168.1.50   # optional; makes reconnects around the CEC wake near-instant
# appletv_url_ok_delay: 12, 5  # first key N s after the launch, later keys M s apart (one number = same gap; 0 = never)
# appletv_url_ok_key: select, play_pause   # keys pressed ok_delay apart: Select picks the "Who's watching?"
#                                          # account, Play/Pause starts the title (Apple TV app)
# appletv_warm_minutes: 10     # a TV launch within this window makes the next figure "warm": no sleep/wake,
# appletv_url_warm_delay: 4    # no chooser keys, just Play this many seconds after the title opens
# deeplink_server: http://192.168.1.50   # the Deeplink tvOS app's web server, for deeplink: tags
# deeplink_app_id: com.celerity.DeepLink  # opened over pyatv when that server is not answering

# Xbox (optional): a figure with `xbox: true` wakes the console, `xbox_app: <store id>`
# then launches an app. Each pad drives ONE console - name it, or every console on
# the account wakes. Quote the id (YAML would read a digit-only one as a number).
# Find ids: /opt/musicfig/.venv/bin/python -c "import app.xboxctl as x, yaml; ..." or
# the laptop's xbox_login helper, which lists them after sign-in. Sign-in tokens live
# only in /opt/musicfig/xbox_tokens.json (never here); the client secret stays here.
# xbox_client_id: "<azure app id>"
# xbox_client_secret: "<azure app secret>"
# xbox_console_id: "F4000F3ACB4A6A80"   # this pad's console
# Samsung TV (optional, local API - no SmartThings cloud, no expiring token).
# The Apple TV / Xbox take the HDMI input themselves over HDMI-CEC; the pad only
# wakes the TV (Wake-on-LAN + KEY_POWER) and clears Samsung's home bar (KEY_EXIT).
# Needs the TV setting "Power On with Mobile" and a one-time pairing (press Allow
# on the TV): sudo MUSICFIG_NO_AUTOSTART=1 PYTHONPATH=/etc/musicfig \
#   /opt/musicfig/.venv/bin/python -m app.samsungtv pair --host <ip> --mac <mac>
# samsungtv_host: 192.168.1.60                     # the TV's IP (required; this alone = configured)
# samsungtv_mac: "AA:BB:CC:DD:EE:FF"               # the TV's Wi-Fi MAC, for Wake-on-LAN
# samsungtv_token_file: /etc/musicfig/samsungtv.token   # default; owner musicfig, mode 0600, never in git
# samsungtv_name: musicfig game-room               # default: musicfig <MUSICFIG_ROOM or hostname>
# samsungtv_wake_timeout: 12                       # seconds to wait for PowerState "on" after a wake
# Room awareness (optional). Each Pi knows its room (MUSICFIG_ROOM, defaults
# to the hostname). A tag can behave differently per room with a `rooms:`
# block, and `homepod: "@room"` targets the HomePod listed for that room here.
room_homepods:
    guest-room: Guest Room HomePod
    game-room: Basement (2)

# Which Yoto player usually sits in which room, for yoto_player: "@room".
# A room with no entry falls back to "@online" (the Yotos are carried around).
room_yoto_players:
    guest-room: Momo's Library

# NFC tags have unique identifiers which are assigned "Spotify URI" actions.
identifier:
    04a68312fe4a80:
        # Same tag, different behaviour per pad: kitchen plays on the panel's
        # own speaker, every other room streams to that room's HomePod.
        name: Peter Pan (room aware)
        airplay: peterpan.mp3
        homepod: "@room"
        rooms:
            kitchen:
                airplay: null        # null drops the inherited key
                mp3: peterpan.mp3
    04112233445566:                 # made-up UID
        # Yoto card (audiobook) streamed to this room's HomePod. Needs the
        # Yoto MCP shared secret in /etc/musicfig/yoto-tracks.key.
        name: Frozen (Yoto)
        yoto_airplay: j5VA8
        homepod: "@room"
    04112233445577:                 # made-up UID
        # The same card played on the real Yoto player ("card to device"):
        # the Pi asks the Yoto MCP to start it; lifting the figure stops it.
        # yoto_player is a player id, its name, "@room" (see room_yoto_players)
        # or, left out, "@online" = whichever Yoto is switched on.
        name: Frozen (on the Yoto)
        yoto: j5VA8
        yoto_player: "@room"
    05631b62124:
        # LEGO minifigure. Play mp3 folder
        name: Peter Pan
        playlist: mp3/folder/name
        shuffle: on
    04831a62714080:
        # LEGO minifigure. Play 11s into the Black Sabbath track.
        name: Ironman
        spotify: track:0TI8TP4FitVPoEHPTySx48
        position_ms: 11000
    04d5dbd2534280:
        # LEGO minifigure. Play Lego Movie 2 soundtrack.
        name: Everything is Awesome
        spotify: album:7vUakEBYI3YXIoAHHRufrq
    ea508007:
        # NTAG213 card
        name: Iron DJ triathlon playlist
        spotify: playlist:2srSxWasD4ZZh4B7ckyihH
    042c52f23d2d80:
        # Disney Infinity character
        name: Jack Sparrow
        spotify: track:4AD2dterIUjNt1LFNI9Bvi
    04ec806a0b4080:
        # LEGO minifigure. Play local mp3 file.
        name: Gramatik
        mp3: justjammin.mp3
    043fd8daa74881:
        # Play TRON and run a system command.
        name: The Grid
        spotify: track:4Bvxi5oUS3M4DezTfsd5pp
        command: uname -a
