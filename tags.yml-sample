# Base path of mp3 folder
mp3_dir: /path/to/base/mp3/folder

# Ligthshow switch
lights: on

# Room awareness (optional). Each Pi knows its room (MUSICFIG_ROOM, defaults
# to the hostname). A tag can behave differently per room with a `rooms:`
# block, and `homepod: "@room"` targets the HomePod listed for that room here.
room_homepods:
    guest-room: Guest Room HomePod
    game-room: Basement (2)

# NFC tags have unique identifiers which are assigned "Spotify URI" actions.
identifier:
    04a68312fe4a80:
        # Same tag, different behaviour per pad: kitchen plays on the panel's
        # own speaker, every other room streams to that room's HomePod.
        name: Peter Pan (room aware)
        airplay: peterpan.mp3
        homepod: "@room"
        rooms:
            kitchen:
                airplay: null        # null drops the inherited key
                mp3: peterpan.mp3
    05631b62124:
        # LEGO minifigure. Play mp3 folder
        name: Peter Pan
        playlist: mp3/folder/name
        shuffle: on
    04831a62714080:
        # LEGO minifigure. Play 11s into the Black Sabbath track.
        name: Ironman
        spotify: track:0TI8TP4FitVPoEHPTySx48
        position_ms: 11000
    04d5dbd2534280:
        # LEGO minifigure. Play Lego Movie 2 soundtrack.
        name: Everything is Awesome
        spotify: album:7vUakEBYI3YXIoAHHRufrq
    ea508007:
        # NTAG213 card
        name: Iron DJ triathlon playlist
        spotify: playlist:2srSxWasD4ZZh4B7ckyihH
    042c52f23d2d80:
        # Disney Infinity character
        name: Jack Sparrow
        spotify: track:4AD2dterIUjNt1LFNI9Bvi
    04ec806a0b4080:
        # LEGO minifigure. Play local mp3 file.
        name: Gramatik
        mp3: justjammin.mp3
    043fd8daa74881:
        # Play TRON and run a system command.
        name: The Grid
        spotify: track:4Bvxi5oUS3M4DezTfsd5pp
        command: uname -a
